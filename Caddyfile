expense-sync-bot.invntrm.ru {
	# Automatic HTTPS with Let's Encrypt

	# Static pages: homepage, privacy policy, terms of service
	handle / {
		root * /var/www/ExpenseSyncBot/public
		rewrite * /index.html
		file_server
	}

	handle /privacy {
		root * /var/www/ExpenseSyncBot/public
		rewrite * /privacy-policy.html
		file_server
	}

	handle /terms {
		root * /var/www/ExpenseSyncBot/public
		rewrite * /terms-of-service.html
		file_server
	}

	# All proxied endpoints — both ports always present: lb_policy first prefers 3311.
	# When 3311 is down, Caddy auto-routes to 3312 (green process during deploy).
	@backend path /callback* /health /api/*
	handle @backend {
		reverse_proxy localhost:3311 localhost:3312 {
			lb_policy       first
			health_uri      /health
			health_interval 2s
			health_timeout  3s
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	# Temporary images for OCR processing
	handle /temp-images/* {
		root * /var/www/ExpenseSyncBot
		file_server
	}

	# Everything else
	handle {
		respond "Not Found" 404
	}

	# Logging
	log {
		output file /var/log/caddy/expensesyncbot.log
		format console
	}
}

expense-sync-bot-app.invntrm.ru {
	# API requests proxied to the Bun server — retry during PM2 reload
	# Must be in a separate handle block BEFORE the SPA catch-all,
	# otherwise try_files rewrites /api/* to /index.html → 405

	# Mini App frontend (Vite build)
	root * /var/www/ExpenseSyncBot/miniapp/dist
	file_server

	# SPA fallback — serve index.html for client-side routing
	try_files {path} /index.html

	# API requests proxied to the Bun server
	handle /api/* {
		reverse_proxy localhost:3311 localhost:3312 {
			lb_policy       first
			health_uri      /health
			health_interval 2s
			health_timeout  3s
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	# Mini App frontend (Vite build) — SPA with client-side routing
	handle {
		root * /var/www/ExpenseSyncBot/miniapp/dist
		try_files {path} /index.html
		file_server
	}

	log {
		output file /var/log/caddy/miniapp.log
		format console
	}
}
