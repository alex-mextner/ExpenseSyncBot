# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_from_botfather
BOT_USERNAME=ExpenseSyncBot

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3311/callback

# Mini App (optional — enables web_app buttons in bot)
# MINIAPP_URL=https://finbot-app.mextner.com

# Google OAuth (legacy) — for users who connected before GCP project migration
# Optional: if absent, legacy token refresh will fail and user must /reconnect
# GOOGLE_LEGACY_CLIENT_ID=old_google_client_id
# GOOGLE_LEGACY_CLIENT_SECRET=old_google_client_secret

# OAuth Server
OAUTH_SERVER_PORT=3311

# Database
DATABASE_PATH=./data/expenses.db

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# Environment
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# AI providers — all OpenAI-compatible (via OpenAI SDK)
#
# Chains:
#   SMART_CHAIN: z.ai AI_MODEL → Claude CLAUDE_MODEL → HF HF_MODEL
#   FAST_CHAIN:  z.ai AI_FAST_MODEL → Claude CLAUDE_FAST_MODEL → HF HF_FAST_MODEL
#   OCR_CHAIN:   Claude CLAUDE_VISION_MODEL → HF HF_VISION_MODEL (fixed order)
#
# The SMART/FAST order is configuration: AI_SMART_CHAIN / AI_FAST_CHAIN, comma-separated provider ids
# (zai, claude, hf, openrouter). Unset = the default order above. Unknown ids are ignored with a warning.
#AI_SMART_CHAIN=zai,claude,hf
#AI_FAST_CHAIN=zai,claude,hf
#
# OpenRouter is optional and in no default order: it runs only when named in a chain order above
# (e.g. AI_SMART_CHAIN=zai,openrouter,claude,hf) AND both its key and the chain's model are set.
#
# z.ai and HF fields are required. Claude is optional: when its key is absent, the slot
# is skipped and the rest of the chain runs unchanged (without CLAUDE_API_TOKEN, OCR is HF-only).
# ─────────────────────────────────────────────────────────────────────────────

# z.ai API key (OpenAI-compat coding endpoint)
# Historical name ANTHROPIC_API_KEY — it's actually the z.ai key.
# Get one at https://z.ai/manage-apikey/apikey-list
ANTHROPIC_API_KEY=your_zai_api_key
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_MODEL=glm-5.1
AI_FAST_MODEL=glm-4.5-flash

# Anthropic Claude via its OpenAI-compatible endpoint (optional; next after z.ai GLM, OCR primary).
# Smart chain uses Sonnet, fast chain (validators, bank prefill, merchant agent) uses Haiku,
# receipt OCR uses CLAUDE_VISION_MODEL (default Sonnet: on degraded receipt photos Haiku emitted a
# wrong but sum-verified receipt, Sonnet refused instead — measured 2026-10-12).
# Claude 5.x rejects `temperature`, so the bot never sends it. Sonnet/Opus keep thinking on at the
# model's own level (the endpoint ignores reasoning_effort) with an 8192-token reserve added to
# max_tokens (thinking shares that budget); Haiku runs with thinking disabled.
# See claudeRequestParams in src/services/ai/streaming.ts.
# After changing the models run scripts/verify-ai-chains.ts (and scripts/run-receipt-snapshots.ts
# for CLAUDE_VISION_MODEL).
# CLAUDE_API_TOKEN=sk-ant-XXX
# CLAUDE_BASE_URL=https://api.anthropic.com/v1/
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_VISION_MODEL=claude-sonnet-5-5

# HuggingFace Router (text fallback + vision fallback)
HF_TOKEN=hf_XXX
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3-235B-A22B
HF_FAST_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# OpenRouter (optional, OpenAI-compatible; skipped when key or model is unset). Model ids are OpenRouter's,
# e.g. deepseek/deepseek-v4.1-flash, z-ai/glm-5.3-flash, anthropic/claude-haiku-5.5.
#OPENROUTER_API_KEY=sk-or-v1-XXX
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_MODEL=
#OPENROUTER_FAST_MODEL=

# AI debug logs — full conversation logs to logs/chats/{chatId}/
# AI_DEBUG_LOGS=true

# Set true to send proactive AI financial insights to chat.
# false (default): triggers are logged for analysis but not sent.
# Budget-exceeded alerts fire regardless of this setting.
AUTO_ADVICE_ENABLED=false

# GitHub (fine-grained PAT for dev pipeline PR operations)
GITHUB_TOKEN=github_pat_XXX

# Admin Telegram user ID — for merchant rule approval cards + deploy/healthcheck alerts (optional)
# If absent, AI merchant rule generation is disabled (no crash on startup)
# BOT_ADMIN_CHAT_ID=

# Large transaction threshold in EUR (default: 100)
# LARGE_TX_THRESHOLD_EUR=100
